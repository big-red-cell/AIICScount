# Copy this file to .env and set the values for the provider you use.
# Each pipeline stage has one consistently named provider configuration.
PHASE1_API_KEY=
PHASE1_BASE_URL=
PHASE1_MODEL=
PHASE1_TIMEOUT=120
PHASE2_API_KEY=
PHASE2_BASE_URL=
PHASE2_MODEL=
PHASE3_API_KEY=
PHASE3_BASE_URL=
PHASE3_MODEL=

# Runtime executables. Leave blank to discover them from PATH/common locations.
CHROME_PATH=
OPENCLAW_PATH=
# Set when OpenClaw's required Node.js is not the system default.
OPENCLAW_NODE_PATH=

# Chromium issue acquisition (copy current values from a browser request).
CHROMIUM_XSRF_TOKEN=
# JSON object or path to a local JSON file; leave empty if cookies are not needed.
CHROMIUM_COOKIES_JSON=
