# Copy this file to .env and set the values for the provider you use.
# Stage 1 reads these values directly from this project's root .env.
LLM_API_KEY=
LLM_API_URL=https://api2.aigcbest.top/v1/chat/completions
LLM_MODEL=deepseek-ai/DeepSeek-V3
LLM_TIMEOUT=120

# Runtime executables. Leave blank to discover them from PATH/common locations.
CHROME_PATH=
OPENCLAW_PATH=

# Phase 3 accepts the standard OpenAI-compatible variables.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.4-mini
CHECK_MODEL=
